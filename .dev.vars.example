# Lokale Secrets für `npm run dev` — Kopie als .dev.vars anlegen (ist gitignored!).
# Produktion: npx wrangler pages secret put <NAME> --project-name blaupause-kit

# Authentifizierter Steady-RSS-Feed mit Volltexten (content:encoded).
# Enthält den pub_auth-Token → niemals committen.
FULLTEXT_FEED_URL=

# Admin-Code für globales Schreiben (Logo, „Für alle Besucher speichern", Revert).
KIT_ADMIN_CODE=

# Optional: Cloudflare Web Analytics (Beacon-Token aus dem Dashboard).
# ANALYTICS_TOKEN=

# Optional (Portabilität): Kit für eine andere Publikation betreiben.
# FEED_URL=
# SITE_ORIGIN=
# STEADY_PUBLICATION_ID=
# STEADY_LOGIN_URL=
