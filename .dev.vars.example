# Lokale Secrets für den Cloudflare-Pfad (npm run dev:cf) — Kopie als .dev.vars anlegen
# (gitignored). Produktion: npx wrangler pages secret put <NAME> --project-name <name>
# Local secrets for the Cloudflare path — copy to .dev.vars (gitignored).

# Admin-Code für globales Schreiben (Panel: „Für alle Besucher speichern", Logo, Revert).
KIT_ADMIN_CODE=

# Optional: Authentifizierter Steady-RSS-Feed mit Volltexten (content:encoded).
# Steady-Backend → Einstellungen → RSS-Feed. Enthält den Auth-Token → niemals committen!
FULLTEXT_FEED_URL=

# Optional: Cloudflare Web Analytics (Beacon-Token aus dem Dashboard).
# ANALYTICS_TOKEN=

# Optional (Overrides — normalerweise kommt alles aus kit.config.js):
# FEED_URL=
# SITE_ORIGIN=
# STEADY_PUBLICATION_ID=
# STEADY_LOGIN_URL=
