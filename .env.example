# Secrets für den Node-Pfad (npm run dev / npm start) — Kopie als .env anlegen.
# .env ist gitignored und bleibt es auch. Cloudflare-Pfad: siehe .dev.vars.example.
# Secrets for the Node path — copy to .env (gitignored). Cloudflare: .dev.vars.example.

# Admin-Code für globales Schreiben (Panel: „Für alle Besucher speichern", Logo, Revert).
# Admin code that gates global writes (publish settings, logo, revert).
KIT_ADMIN_CODE=

# Optional: Authentifizierter Steady-RSS-Feed mit Volltexten (content:encoded).
# Steady-Backend → Einstellungen → RSS-Feed. Enthält den Auth-Token → niemals committen!
# Optional: authenticated Steady RSS feed with full text. Never commit it!
FULLTEXT_FEED_URL=

# Optional: eigener Port / eigenes Datenverzeichnis des Node-Servers.
# PORT=8788
# KIT_DATA_DIR=./data

# Optional (Overrides — normalerweise kommt alles aus kit.config.js):
# One-Click-Deploys (Railway u. a.): STEADY_SLUG genügt, leitet Feed + Login ab.
# STEADY_SLUG=
# FEED_URL=
# SITE_ORIGIN=
# STEADY_PUBLICATION_ID=
# STEADY_LOGIN_URL=
# ANALYTICS_TOKEN=
